# Beneficiary Credit Scoring — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit the .env file with real credentials to version control.

# ── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=credit_scoring
DB_USER=credituser
DB_PASSWORD=creditpass
MYSQL_ROOT_PASSWORD=rootpass

# ── Spring Boot (used when running via Docker Compose) ────────────────────────
# The backend container references the MySQL container by its service name
SPRING_DATASOURCE_URL=jdbc:mysql://mysql_db:3306/credit_scoring?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=credituser
SPRING_DATASOURCE_PASSWORD=creditpass

# ── ML Service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
